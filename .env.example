# TravelAI local development â€” fake values only
# Copy to .env and adjust ports if needed.

COMPOSE_PROJECT_NAME=travelai

# Postgres
POSTGRES_USER=travelai
POSTGRES_PASSWORD=travelai_dev
POSTGRES_DB=travelai
POSTGRES_HOST_PORT=5432
IDENTITY_DB=travelai_identity

# Redis
REDIS_URL=redis://redis:6379
REDIS_HOST_PORT=6379

# Meilisearch
MEILI_MASTER_KEY=travelai_meili_dev_key_change_me
MEILI_HOST=http://meilisearch:7700
MEILI_HOST_PORT=7700

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=travelai

# Identity (:3002)
IDENTITY_PORT=3002
IDENTITY_DATABASE_URL=postgresql://travelai:travelai_dev@postgres:5432/travelai_identity
IDENTITY_JWT_ISSUER=https://identity.travelai.local
IDENTITY_JWT_AUDIENCE=travelai-web
# Ed25519 PKCS8 PEM (base64 or multiline). Generate: openssl genpkey -algorithm Ed25519
IDENTITY_JWT_PRIMARY_PRIVATE_KEY=
IDENTITY_JWT_SECONDARY_PRIVATE_KEY=
IDENTITY_COOKIE_SECRET=dev_cookie_secret_change_me_32chars
DEMO_USER_EMAIL=demo@travelai.local
DEMO_USER_PASSWORD=DemoTravelAI1!
# Local only — never true in production
SEED_DEMO_USER=true
# Fail-closed PEMs when production: JWT_REQUIRE_PEM=true (or NODE_ENV=production)
# Optional multi-subdomain refresh cookie (empty = host-only, recommended for local)
# COOKIE_DOMAIN=.example.com
# COOKIE_SAMESITE=None
# ALLOW_BODY_REFRESH=false
# METRICS_TOKEN=  # empty = open metrics locally; set in production
# NEXT_PUBLIC_PERSIST_ACCESS=false  # true = sessionStorage access (weaker XSS posture)
# --- Mailer (api notify) — empty SMTP = log-only ---
# SMTP_URL=smtp://user:pass@localhost:1025
# SMTP_URL=https://mail-gateway.example/send   # HTTP POST JSON gateway
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# SMTP_FROM=TravelAI <noreply@travelai.local>

# --- Embeddings / vectors (optional) ---
# EMBEDDING_API_KEY=          # or OPENAI_API_KEY; empty = local hash vectors (demo)
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# PINECONE_API_KEY=
# PINECONE_INDEX=travelai-catalog

# DEEPSEEK_API_KEY=  # also used by ai service for /v1/chat/stream when set

# API (:3001)
API_PORT=3001
DATABASE_URL=postgresql://travelai:travelai_dev@postgres:5432/travelai
DIRECT_URL=postgresql://travelai:travelai_dev@postgres:5432/travelai
IDENTITY_JWKS_URL=http://identity:3002/.well-known/jwks.json
IDENTITY_ISSUER=https://identity.travelai.local
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:53000,http://127.0.0.1:53000
RUN_SEED=true

# AI orchestrator (:3003)
AI_PORT=3003
N8N_WEBHOOK_BASE_URL=http://n8n:5678/webhook
N8N_HMAC_SECRET=travelai_n8n_hmac_dev_secret_change_me
AI_DEGRADED_MODE=false

# DeepSeek (live chatbot / travel-chat webhook) — never commit real keys
# Get a key: https://platform.deepseek.com/api_keys
# Local compose overlay routes AI → chat-webhook → DeepSeek when set.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Admin dual-factor for Meili reindex (optional). When set (≥16 chars), clients must send X-Admin-Token.
ADMIN_REINDEX_TOKEN=

# n8n
N8N_HOST_PORT=5678
N8N_ENCRYPTION_KEY=travelai_n8n_encryption_key_32b
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=n8n_admin_dev


# Web (:3000)
WEB_PORT=3000
# Browser (host machine)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_IDENTITY_URL=http://localhost:3002
NEXT_PUBLIC_AI_URL=http://localhost:3003
NEXT_PUBLIC_DEFAULT_LOCALE=vi
# SSR inside Docker network (compose service names)
API_INTERNAL_URL=http://api:3001
IDENTITY_INTERNAL_URL=http://identity:3002
AI_INTERNAL_URL=http://ai:3003

# App
NODE_ENV=development
LOG_LEVEL=info

