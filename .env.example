# TravelAI local development â€” fake values only
# Copy to .env and adjust ports if needed.

COMPOSE_PROJECT_NAME=travelai

# Postgres
POSTGRES_USER=travelai
POSTGRES_PASSWORD=travelai_dev
POSTGRES_DB=travelai
POSTGRES_HOST_PORT=5432
IDENTITY_DB=travelai_identity

# Redis
REDIS_URL=redis://redis:6379
REDIS_HOST_PORT=6379

# Meilisearch
MEILI_MASTER_KEY=travelai_meili_dev_key_change_me
MEILI_HOST=http://meilisearch:7700
MEILI_HOST_PORT=7700

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=travelai

# Identity (:3002)
IDENTITY_PORT=3002
IDENTITY_DATABASE_URL=postgresql://travelai:travelai_dev@postgres:5432/travelai_identity
IDENTITY_JWT_ISSUER=https://identity.travelai.local
IDENTITY_JWT_AUDIENCE=travelai-web
# Ed25519 PKCS8 PEM (base64 or multiline). Generate: openssl genpkey -algorithm Ed25519
IDENTITY_JWT_PRIMARY_PRIVATE_KEY=
IDENTITY_JWT_SECONDARY_PRIVATE_KEY=
IDENTITY_COOKIE_SECRET=dev_cookie_secret_change_me_32chars
DEMO_USER_EMAIL=demo@travelai.local
DEMO_USER_PASSWORD=DemoTravelAI1!

# API (:3001)
API_PORT=3001
DATABASE_URL=postgresql://travelai:travelai_dev@postgres:5432/travelai
DIRECT_URL=postgresql://travelai:travelai_dev@postgres:5432/travelai
IDENTITY_JWKS_URL=http://identity:3002/.well-known/jwks.json
IDENTITY_ISSUER=https://identity.travelai.local
CORS_ORIGINS=http://localhost:3000

# AI orchestrator (:3003)
AI_PORT=3003
N8N_WEBHOOK_BASE_URL=http://n8n:5678/webhook
N8N_HMAC_SECRET=travelai_n8n_hmac_dev_secret_change_me
AI_DEGRADED_MODE=false

# DeepSeek (live chatbot / travel-chat webhook) â€” never commit real keys
# Get a key: https://platform.deepseek.com/api_keys
# Local compose overlay routes AI â†’ chat-webhook â†’ DeepSeek when set.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# n8n
N8N_HOST_PORT=5678
N8N_ENCRYPTION_KEY=travelai_n8n_encryption_key_32b
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=n8n_admin_dev


# Web (:3000)
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_IDENTITY_URL=http://localhost:3002
NEXT_PUBLIC_AI_URL=http://localhost:3003
NEXT_PUBLIC_DEFAULT_LOCALE=vi

# App
NODE_ENV=development
LOG_LEVEL=info

