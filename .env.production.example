# TravelAI production template — replace every placeholder before deploy.
# NEVER commit real secrets.

COMPOSE_PROJECT_NAME=travelai
IMAGE_TAG=sha-<full-git-commit-sha>

POSTGRES_USER=travelai
POSTGRES_PASSWORD=<strong-random-password>
POSTGRES_DB=travelai
IDENTITY_DB=travelai_identity

# Use URL-safe characters: Compose injects this password into service REDIS_URL values.
REDIS_PASSWORD=<strong-url-safe-random-password>
MEILI_MASTER_KEY=<strong-random-meili-key>
MEILI_HOST=http://meilisearch:7700

MINIO_ROOT_USER=<minio-user>
MINIO_ROOT_PASSWORD=<strong-minio-password>
MINIO_BUCKET=travelai

IDENTITY_DATABASE_URL=postgresql://travelai:<password>@postgres:5432/travelai_identity
IDENTITY_JWT_ISSUER=https://identity.example.com
IDENTITY_JWT_AUDIENCE=travelai-web
IDENTITY_JWT_PRIMARY_PRIVATE_KEY=<ed25519-pkcs8-pem>
IDENTITY_JWT_SECONDARY_PRIVATE_KEY=<ed25519-pkcs8-pem-previous>
IDENTITY_COOKIE_SECRET=<32+-char-secret>

DATABASE_URL=postgresql://travelai:<password>@postgres:5432/travelai
DIRECT_URL=postgresql://travelai:<password>@postgres:5432/travelai
IDENTITY_JWKS_URL=http://identity:3002/.well-known/jwks.json
IDENTITY_ISSUER=https://identity.example.com
CORS_ORIGINS=https://travelai.example.com

# Mailer (optional; empty = log-only)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=TravelAI <noreply@example.com>

# Embeddings / Pinecone (optional; empty = local hash vectors + Postgres store)
# EMBEDDING_API_KEY=
# PINECONE_API_KEY=
# PINECONE_INDEX=travelai-catalog

N8N_WEBHOOK_BASE_URL=http://n8n:5678/webhook
N8N_HMAC_SECRET=<32+-character-random-hmac-secret>
AI_DEGRADED_MODE=false

N8N_ENCRYPTION_KEY=<32-byte-key>
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=<strong-password>

NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_IDENTITY_URL=https://identity.example.com
NEXT_PUBLIC_AI_URL=https://ai.example.com
NEXT_PUBLIC_DEFAULT_LOCALE=vi

NODE_ENV=production
LOG_LEVEL=info
