{
  "name": "@travelai/ai",
  "version": "0.1.0",
  "private": true,
  "description": "TravelAI trip planner orchestrator (HMAC → n8n)",
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs watch src/main.ts",
