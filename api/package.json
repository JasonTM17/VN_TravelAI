{
  "name": "@travelai/api",
  "version": "0.1.0",
  "private": true,
  "description": "TravelAI catalog, search, bookings API",
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs watch src/main.ts",
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "node ./node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "prisma:generate": "node ./node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node ./node_modules/prisma/build/index.js migrate deploy",
    "prisma:dev": "node ./node_modules/prisma/build/index.js migrate dev",
    "seed": "node ./node_modules/tsx/dist/cli.mjs prisma/seed.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@prisma/client": "^6.5.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.5.0",
    "jose": "^5.9.6",
    "meilisearch": "^0.49.0",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "tsx": "^4.19.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "prisma": "^6.5.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "esbuild"
    ]
  }
}
